# SMS side of the gateway. NOT active until copied to /etc/kannel/sms.conf
# (install.sh enable-sms does this once the SIM800C HAT is fitted).

group = smsc
smsc = at
smsc-id = hat
modemtype = sim800
device = /dev/serial0
speed = 115200
# The HAT SIM's own number, international format.
my-number = "@MODEM_NUMBER@"
sim-buffering = true
log-file = "/var/log/kannel/smsc-hat.log"
log-level = 1

group = modems
id = sim800
name = "SIMCom SIM800C"
detect-string = "SIM800"
# The HAT connects only the two data lines, so there is no RTS/CTS
# handshake. Both of these are needed. Without the first, Kannel waits
# for ever to send. Without the second, Kannel tells the modem to use the
# handshake (its default is AT+IFC=2,2), and the modem then falls silent
# until it is switched off and on.
hardware-flow-control = false
enable-hwhs = "AT+IFC=0,0"
# Incoming messages are stored on the SIM and announced; Kannel then
# reads and deletes them (sim-buffering above), so none is lost while
# Kannel is not running.
init-string = "AT+CNMI=2,1,0,0,0;+CMEE=1"
message-storage = "SM"
need-sleep = true

group = smsbox
bearerbox-host = 127.0.0.1
sendsms-port = 13014
log-file = "/var/log/kannel/smsbox.log"
log-level = 1

group = sendsms-user
username = wapsms
password = @SENDSMS_PASSWORD@
user-allow-ip = "127.0.0.1"
user-deny-ip = "*.*.*.*"

# Every incoming message goes to wapsms.py, which passes WAP requests
# from the allowed phone on to wap-over-sms and files ordinary texts in
# an inbox. An empty answer means no reply is sent.
group = sms-service
keyword = default
post-url = "http://127.0.0.1:8090/in?token=@TOKEN@"
send-sender = 1
max-messages = 0
catch-all = true
omit-empty = true
