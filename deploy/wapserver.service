[Unit]
Description=WAP page server (WML for the Nokia 7110)
After=network.target

[Service]
User=wapgw
ExecStart=/usr/bin/python3 /opt/wapgateway/wapserver.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The calorie and cash journals live here (shared with wapfetch).
StateDirectory=wapgateway

[Install]
WantedBy=multi-user.target
